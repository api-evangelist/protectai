{
  "opencollection": "1.0.0",
  "info": {
    "name": "LLM Guard Output API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Output",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Analyze and sanitize an output.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:8000/analyze/output",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Runs the configured output scanners over the LLM response (with the originating prompt for context) and returns the sanitized output, an overall validity flag, and per-scanner risk scores."
        },
        {
          "info": {
            "name": "Scan an output.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:8000/scan/output",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Runs the configured output scanners over the LLM response (with the originating prompt for context) and returns the validity flag and per-scanner risk scores without returning a modified output."
        }
      ]
    }
  ],
  "bundled": true
}